{"W":1440,"H":15151,"bg":"rgb(0, 0, 0)","out":[{"t":"p","r":[35,19,38,60],"tx":"A","fs":50,"al":"start","st":"normal","mv":"sticky"},{"t":"p","r":[499,39,43,18],"tx":"HOME","fs":15,"al":"start","st":"normal","mv":"sticky"},{"t":"p","r":[566,39,53,18],"tx":"ABOUT","fs":15,"al":"start","st":"normal","mv":"sticky"},{"t":"p","r":[643,39,65,18],"tx":"PROJECT","fs":15,"al":"start","st":"normal","mv":"sticky"},{"t":"p","r":[731,39,35,18],"tx":"PLAY","fs":15,"al":"start","st":"normal","mv":"sticky"},{"t":"p","r":[790,39,68,18],"tx":"CONTACT","fs":15,"al":"start","st":"normal","mv":"sticky"},{"t":"p","r":[883,39,58,18],"tx":"RESUME","fs":15,"al":"start","st":"normal","mv":"sticky"},{"t":"p","r":[84,177,1272,132],"tx":"parde ke peeche","fs":110,"al":"start","st":"normal","mv":""},{"t":"p","r":[221,371,998,113],"tx":"A publication design project exploring the unseen craft, design, and storytelling behind Bollywood.","fs":47,"al":"start","st":"normal","mv":""},{"t":"p","r":[81,600,17,20],"tx":"00","fs":14,"al":"start","st":"normal","mv":""},{"t":"img","r":[82,659,1277,714],"src":"jKbW15pOCyOKgnwzV0fDkMba6hs.png","nat":[4500,3000],"fit":"cover","mv":"","tf":"none"},{"t":"p","r":[81,1412,17,20],"tx":"00","fs":14,"al":"start","st":"normal","mv":""},{"t":"p","r":[1063,1468,34,20],"tx":"year","fs":14,"al":"start","st":"normal","mv":"sticky"},{"t":"h1","r":[86,1470,728,540],"tx":"Parede ke peeche is a 20-page publication I designed as part of my communication design program. The magazine explores the hidden craft of Bollywood, such as cinematography, sound design, choreography, set design, poster art, and motion titles. Instead of focusing on celebrity culture, the publication celebrates the people and processes that shape the visual experience of Indian cinema.","fs":36,"al":"start","st":"normal","mv":""},{"t":"p","r":[1063,1497,291,35],"tx":"2025","fs":20,"al":"start","st":"normal","mv":"sticky"},{"t":"p","r":[1063,1564,76,20],"tx":"timeframe","fs":14,"al":"start","st":"normal","mv